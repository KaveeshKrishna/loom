generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(FAMILY)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  aclRules      AclRule[]
  favorites     Favorite[]
  auditLogs     AuditLog[]
  scanJobs      ScanJob[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Role {
  OWNER
  FAMILY
}

// ─────────────────────────────────────────────
// ACL
// ─────────────────────────────────────────────

model AclRule {
  id        String   @id @default(cuid())
  userId    String
  path      String   // Relative path, e.g. "Pics/Private"
  allow     Boolean  // true = allow, false = deny
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, path])
  @@map("acl_rules")
}

// ─────────────────────────────────────────────
// FILE INDEX
// ─────────────────────────────────────────────

model FileNode {
  id           String    @id @default(cuid())
  relativePath String    @unique  // e.g. "Pics/Vacation/IMG_0001.jpg"
  name         String
  type         NodeType
  mimeType     String?
  size         BigInt?
  modifiedAt   DateTime?
  sha256       String?
  indexedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isVisible    Boolean   @default(true)  // false for OS metadata dirs

  thumbnail    Thumbnail?
  preview      Preview?
  favorites    Favorite[]

  @@index([relativePath])
  @@index([type])
  @@map("file_nodes")
}

enum NodeType {
  FILE
  DIRECTORY
}

// ─────────────────────────────────────────────
// THUMBNAILS & PREVIEWS (stored in /cache)
// ─────────────────────────────────────────────

model Thumbnail {
  id           String   @id @default(cuid())
  fileNodeId   String   @unique
  cachePath    String   // Relative to /cache, e.g. "thumbnails/abc123.webp"
  width        Int
  height       Int
  generatedAt  DateTime @default(now())

  fileNode     FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}

model Preview {
  id           String   @id @default(cuid())
  fileNodeId   String   @unique
  cachePath    String   // Relative to /cache, e.g. "previews/abc123.webp"
  width        Int?
  height       Int?
  generatedAt  DateTime @default(now())

  fileNode     FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@map("previews")
}

// ─────────────────────────────────────────────
// FAVORITES
// ─────────────────────────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  fileNodeId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileNode   FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, fileNodeId])
  @@map("favorites")
}

// ─────────────────────────────────────────────
// SCAN JOBS (DB-backed job queue — no filesystem watcher)
// ─────────────────────────────────────────────

model ScanJob {
  id             String      @id @default(cuid())
  // FULL_RESCAN — walk all of /media (Owner-only Rescan Library action)
  // INDEX_FILE  — index a single file after an internal upload
  type           ScanType    @default(FULL_RESCAN)
  status         ScanStatus  @default(PENDING)
  requestedBy    String?
  requestedAt    DateTime    @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  processedFiles Int         @default(0)
  totalFiles     Int         @default(0)
  // Only set for INDEX_FILE jobs: relative path inside /media
  targetPath     String?

  user           User?       @relation(fields: [requestedBy], references: [id])

  @@map("scan_jobs")
}

enum ScanType {
  FULL_RESCAN
  INDEX_FILE
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// SYSTEM STATUS
// ─────────────────────────────────────────────

model SystemStatus {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_status")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@map("audit_logs")
}
