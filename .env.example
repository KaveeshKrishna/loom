# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_strong_password

# Constructed automatically in compose.yml — you do not normally set this here.
# If running outside Docker, set it manually:
# DATABASE_URL=postgresql://loom:change_this_strong_password@localhost:5432/loom

# ─── Owner Account ────────────────────────────────────────────────────────────
# Created automatically on first launch if it does not exist.
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=change_this_strong_password
OWNER_NAME=Owner

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate_a_long_random_secret_here
BETTER_AUTH_URL=https://loom.yourdomain.com
TRUSTED_ORIGINS=https://loom.yourdomain.com

# ─── Host-Side Mount Service ──────────────────────────────────────────────────
# The mount service runs on the host OS, outside Docker.
# The Loom containers reach it via host.docker.internal.
MOUNT_SERVICE_URL=http://host.docker.internal:8084
MOUNT_SERVICE_SECRET=generate_another_long_random_secret_here

# ─── Next.js ──────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
