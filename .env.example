# ─── Storage Paths (host machine) ─────────────────────────────────────────────
# Where your actual files live, and where Loom stores thumbnails/previews/HLS
# segments. These can be any path on the host — a mounted external drive, a
# local directory, a NAS mount, etc. Loom never writes into LOOM_MEDIA_PATH
# except into its own sandboxed .LoomTrash/ and .tmp-upload/ subdirectories.
LOOM_MEDIA_PATH=./data/media
LOOM_CACHE_PATH=./data/cache

# ─── Network ───────────────────────────────────────────────────────────────────
# Bind address + port for the web app on the host. 127.0.0.1 (default) means
# only reachable via a local reverse proxy (Caddy/nginx/Traefik) or tunnel —
# see docs/REVERSE-PROXY.md. Set to 0.0.0.0 only if you know what you're doing.
LOOM_BIND=127.0.0.1
LOOM_PORT=8085

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_strong_password

# Constructed automatically in compose.yml — you do not normally set this here.
# If running outside Docker, set it manually:
# DATABASE_URL=postgresql://loom:change_this_strong_password@localhost:5432/loom

# ─── Better Auth ──────────────────────────────────────────────────────────────
# At least 32 random characters. loom-web refuses to start with this example
# value. The installer generates one: openssl rand -base64 48
BETTER_AUTH_SECRET=generate_a_long_random_secret_here
BETTER_AUTH_URL=https://loom.example.com
TRUSTED_ORIGINS=https://loom.example.com

# ─── Uploads & background work (optional — defaults shown) ─────────────────────
# Size of each upload chunk in MB. Must be below your reverse proxy's request
# size limit (Cloudflare: 100 MB). See docs/CONFIGURATION.md.
# LOOM_UPLOAD_CHUNK_MB=32
# Largest single upload allowed, in GB (default: no limit).
# LOOM_MAX_UPLOAD_GB=
# How many files the scanner processes in parallel (thumbnails, previews...).
# LOOM_WORKER_CONCURRENCY=2
# How many videos can be converted for streaming at the same time.
# LOOM_MAX_TRANSCODES=2
# Days to keep audit log entries.
# LOOM_AUDIT_RETENTION_DAYS=180

# How long an app's unfinished upload stays resumable without progress, in days.
# LOOM_UPLOAD_RESUME_DAYS=7

# ─── LAN access for the apps (optional) ───────────────────────────────────────
# Run ./scripts/lan.sh enable to turn it on; it fills these in.
# See docs/CONFIGURATION.md → LAN access.
# COMPOSE_PROFILES=lan
# LOOM_LAN_HOST=192.168.1.20
# LOOM_LAN_PORT=8443
# LOOM_LAN_BIND=192.168.1.20
# LOOM_LAN_PKI_PATH=./data/lan-pki

# ─── Scripts (optional) ───────────────────────────────────────────────────────
# How many database backups scripts/backup-db.sh keeps in backups/.
# LOOM_KEEP_BACKUPS=10

# ─── Next.js ──────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
