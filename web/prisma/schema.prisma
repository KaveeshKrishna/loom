generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH (Better Auth Core)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  password      String?
  role          Role      @default(FAMILY)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  aclRules       AclRule[]
  favorites      Favorite[]
  auditLogs      AuditLog[]
  scanJobs       ScanJob[]
  trashItems     TrashItem[]
  backgroundJobs BackgroundJob[]
  notifications  Notification[]
  uploadSessions UploadSession[]
  shareLinks     ShareLink[]
  devices        Device[]
  devicePairings DevicePairing[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  // The app whose embedded browser this session belongs to (lib/devices.ts);
  // removing the app signs it out too. Null for normal browser sign-ins.
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("verifications")
}

enum Role {
  OWNER
  FAMILY
}

// ─────────────────────────────────────────────
// ACL
// ─────────────────────────────────────────────

model AclRule {
  id        String   @id @default(cuid())
  userId    String
  path      String   // Relative path, e.g. "Pics/Private"
  allow     Boolean  // true = allow, false = deny
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, path])
  @@map("acl_rules")
}

// ─────────────────────────────────────────────
// CONTENT IDENTITY
// Represents unique file content, decoupled from filesystem location.
// Multiple FileNodes can share one ContentIdentity — enabling
// one physical thumbnail/preview for N identical files.
// Computed lazily (only when file is actually read). Never during
// plain metadata-only Rescan, preserving the idle-SSD optimization.
// ─────────────────────────────────────────────

model ContentIdentity {
  id        String   @id @default(cuid())
  size      BigInt
  // SHA-256 of first 1MB + last 1MB — highly reliable candidate identity.
  // Not mathematical proof of bit-identical content; sufficient for deduplication.
  fastHash  String
  createdAt DateTime @default(now())
  // Media metadata extracted by the scanner the first time the content is
  // processed: { width, height, takenAt, camera, lens, gps, durationSeconds,
  // videoCodec, audioCodec, ... }. Shared by every FileNode with this content.
  mediaInfo Json?

  nodes       FileNode[]
  thumbnail   Thumbnail?
  preview     Preview?
  videoCaches VideoCache[]

  @@unique([size, fastHash])
  @@map("content_identities")
}

// ─────────────────────────────────────────────
// FILE INDEX
// ─────────────────────────────────────────────

enum HealthStatus {
  // File is accessible and processable.
  HEALTHY
  // File is valid/recognizable but Loom's pipeline does not support it.
  // Must NOT be shown to the user as corrupt — only as unsupported.
  UNSUPPORTED
  // File appears structurally damaged or invalid based on attempted analysis.
  CORRUPT
}

model FileNode {
  id                String       @id @default(cuid())
  // Current logical filesystem location relative to /media.
  // NOT @unique — uniqueness enforced at application level to allow
  // safe Trash state management without ambiguous DB constraints.
  relativePath      String
  // relativePath of the containing directory ("" for top-level items).
  // Denormalized so a folder listing is a single indexed equality lookup
  // instead of a prefix scan over the whole library.
  parentPath        String       @default("")
  name              String
  type              NodeType
  mimeType          String?
  size              BigInt?
  modifiedAt        DateTime?
  sha256            String?
  indexedAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isVisible         Boolean      @default(true)  // false for OS metadata dirs

  // Metadata-only file identity — "${size}-${mtimeMs}"; null until first scan.
  // Used ONLY to detect external modifications. NOT a content identity.
  sourceVersion     String?

  // null = unknown (not yet probed), true = native browser playback, false = needs HLS
  browserCompatible Boolean?

  // Content-based identity — resolved lazily when file is actually read.
  // Enables sharing derived media across identical files.
  // Reset to null when sourceVersion changes (re-evaluation required).
  contentIdentityId String?
  contentIdentity   ContentIdentity? @relation(fields: [contentIdentityId], references: [id], onDelete: SetNull)

  // File health — tied to sourceVersion at check time.
  // Invalidated when sourceVersion changes. HEALTHY by default.
  healthStatus         HealthStatus @default(HEALTHY)
  // Error/diagnostic message from ffprobe/sharp/etc.
  healthError          String?
  // The sourceVersion when health was last checked — used to skip redundant analysis.
  healthCheckedVersion String?

  // Trash state — true while item lives in .LoomTrash
  inTrash      Boolean   @default(false)
  trashItem    TrashItem?

  favorites    Favorite[]
  shareLinks   ShareLink[]

  // NOTE: two extra indexes live only in migration SQL because Prisma's
  // schema language cannot express them (see web/prisma/migrations/
  // 20260926000000_v2_foundation/migration.sql):
  //   - file_nodes_relativePath_pattern_idx  (text_pattern_ops, for prefix LIKE)
  //   - file_nodes_live_relativePath_key     (UNIQUE WHERE "inTrash" = false)
  // If `prisma migrate dev` ever proposes dropping them, delete those lines
  // from the generated migration.
  @@index([relativePath])
  @@index([parentPath, inTrash, isVisible])
  @@index([contentIdentityId])
  @@index([mimeType, modifiedAt])
  @@index([modifiedAt])
  @@index([type])
  @@index([inTrash])
  @@index([healthStatus])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "file_nodes_name_trgm_idx")
  @@map("file_nodes")
}

enum NodeType {
  FILE
  DIRECTORY
}

// ─────────────────────────────────────────────
// THUMBNAILS & PREVIEWS (stored in /cache)
// Now keyed to ContentIdentity, not FileNode.
// Multiple identical files share one thumbnail/preview record.
// profileVersion guards against stale caches if generation params change.
// ─────────────────────────────────────────────

model Thumbnail {
  id                String          @id @default(cuid())
  contentIdentityId String          @unique
  // Relative to /cache, e.g. "thumbnails/{contentIdentityId}_v1.webp"
  cachePath         String
  width             Int
  height            Int
  generatedAt       DateTime        @default(now())
  // Increment this constant in code when thumbnail generation params change
  // to prevent old caches from being reused with new settings.
  profileVersion    String          @default("v1")

  contentIdentity   ContentIdentity @relation(fields: [contentIdentityId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}

model Preview {
  id                String          @id @default(cuid())
  contentIdentityId String          @unique
  // Relative to /cache, e.g. "previews/{contentIdentityId}_v1.webp"
  cachePath         String
  width             Int?
  height            Int?
  generatedAt       DateTime        @default(now())
  profileVersion    String          @default("v1")

  contentIdentity   ContentIdentity @relation(fields: [contentIdentityId], references: [id], onDelete: Cascade)

  @@map("previews")
}

// ─────────────────────────────────────────────
// VIDEO HLS CACHE (stored in /cache/videos/)
// Now keyed to ContentIdentity + profileVersion.
// profileVersion prevents incorrect HLS reuse after FFmpeg setting changes.
// ─────────────────────────────────────────────

model VideoCache {
  id                String          @id @default(cuid())
  contentIdentityId String
  // Encoding profile version — keyed by contentIdentity + profileVersion.
  // Ensures HLS cache is not reused across encoding-setting changes.
  profileVersion    String          @default("v1")
  // relative to /cache, e.g. "videos/{contentIdentityId}/v1"
  cacheDir          String
  sizeBytes         BigInt          @default(0)
  durationSeconds   Float?          // from ffprobe, stored once, reused
  lastAccessedAt    DateTime        @default(now())

  contentIdentity   ContentIdentity @relation(fields: [contentIdentityId], references: [id], onDelete: Cascade)

  @@unique([contentIdentityId, profileVersion])
  @@map("video_cache")
}

// ─────────────────────────────────────────────
// FAVORITES
// ─────────────────────────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  fileNodeId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileNode   FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, fileNodeId])
  @@index([fileNodeId])
  @@map("favorites")
}

// ─────────────────────────────────────────────
// SCAN JOBS (DB-backed job queue — no filesystem watcher)
// The scanner claims jobs with SELECT ... FOR UPDATE SKIP LOCKED and is woken
// instantly by NOTIFY loom_jobs (with a slow poll as a fallback).
// ─────────────────────────────────────────────

model ScanJob {
  id             String      @id @default(cuid())
  // FULL_RESCAN  — walk all of /media (Owner-only Rescan Library action)
  // INDEX_FILE   — index a single path (legacy; kept for old queued rows)
  // PROCESS_FILE — generate derived media (hash, thumbnail, preview, probe,
  //                EXIF) for one FileNode after an upload/edit. Runs in its own
  //                lane so it never waits behind a full rescan.
  type           ScanType    @default(FULL_RESCAN)
  status         ScanStatus  @default(PENDING)
  requestedBy    String?
  requestedAt    DateTime    @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  processedFiles Int         @default(0)
  totalFiles     Int         @default(0)
  // Only set for INDEX_FILE / PROCESS_FILE jobs: relative path inside /media
  targetPath     String?
  // PROCESS_FILE only: the node to process and the sourceVersion it had when
  // the job was queued. If the file changed since, the job is skipped (a
  // newer job will have been queued for the new version).
  fileNodeId     String?
  sourceVersion  String?
  attempts       Int         @default(0)

  user           User?       @relation(fields: [requestedBy], references: [id])

  @@index([status, type, requestedAt])
  @@map("scan_jobs")
}

enum ScanType {
  FULL_RESCAN
  INDEX_FILE
  PROCESS_FILE
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// SYSTEM STATUS
// ─────────────────────────────────────────────

model SystemStatus {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_status")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// TRASH
// Three path concepts explicitly separated:
//   FileNode.relativePath    = current logical filesystem location
//   TrashItem.originalPath   = exact path before deletion (for restore)
//   TrashItem.trashPath      = physical path inside .LoomTrash/
// Restoration stops (409) if originalPath is occupied — no silent renames,
// unless the user explicitly picks "keep both" or a different destination.
// kind = "DELETE"  — the item was deleted by a user
// kind = "VERSION" — a previous version saved automatically before an
//                    in-browser text edit overwrote the file
// ─────────────────────────────────────────────

model TrashItem {
  id              String   @id @default(cuid())
  fileNodeId      String   @unique
  // Exact original relative path before deletion — used to detect restore conflicts
  originalPath    String
  // Physical path inside /media/.LoomTrash/
  trashPath       String
  deletedAt       DateTime @default(now())
  // Automatically purged 15 days after deletion
  expiresAt       DateTime
  // Null once the deleting user's account is removed (the item stays in the
  // Owner's trash view until it expires).
  deletedByUserId String?
  kind            String   @default("DELETE")

  user            User?    @relation(fields: [deletedByUserId], references: [id], onDelete: SetNull)
  fileNode        FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deletedByUserId])
  @@map("trash_items")
}

// ─────────────────────────────────────────────
// BACKGROUND JOBS
// Tracks long-running server-side operations (large copy/move/folder delete)
// ─────────────────────────────────────────────

model BackgroundJob {
  id          String   @id @default(cuid())
  // COPY, MOVE, FOLDER_DELETE, UPLOAD_FINALIZE
  type        String
  // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  status      String
  // Operation-specific payload (source, dest, fileNodeIds, etc.)
  payload     Json
  error       String?
  progress    Int      @default(0)  // 0–100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("background_jobs")
}

// ─────────────────────────────────────────────
// UPLOAD SESSIONS
// One row per in-progress chunked upload, written to
// /media/.tmp-upload/{id}.partial. Two modes:
//  mode = "stream" — chunks arrive in order (the browser); `received` always
//                    equals the partial file's size after each accepted
//                    chunk, which makes resuming idempotent.
//  mode = "chunks" — chunks of `chunkSize` arrive in any order, several at
//                    once (the apps); `chunkMap` has one bit per chunk
//                    received and `received` counts their bytes.
// Expired sessions (and their partial files) are purged by the scanner.
// ─────────────────────────────────────────────

model UploadSession {
  id           String   @id @default(cuid())
  userId       String
  // Destination directory relative to /media ("" = root)
  destDir      String
  // Path of the file relative to destDir (folder uploads include sub-dirs)
  relativePath String
  size         BigInt
  received     BigInt   @default(0)
  // Client-side File.lastModified (ms) — applied to the final file so photos
  // and videos keep their original dates.
  lastModified BigInt?
  mimeType     String?
  mode         String   @default("stream")
  // Fixed when the session is created (mode "chunks"); null = the server's
  // current chunk size.
  chunkSize    Int?
  chunkMap     Bytes?
  // Chosen by the app, so a retried "create" returns the same session.
  clientRef    String?
  // The app that created the session (null = the browser).
  deviceId     String?
  // The finished file (mode "chunks"), kept for a day so a repeated
  // "complete" gets the same answer instead of an error.
  result       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRef])
  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("upload_sessions")
}

// ─────────────────────────────────────────────
// SHARE LINKS
// Public links to one file or folder for people without an account.
// Disabled unless the Owner turns sharing on (SystemStatus "sharing_enabled").
//  - The token (256 random bits) is looked up by its SHA-256; an AES-GCM
//    encrypted copy (key derived from BETTER_AUTH_SECRET) lets the creator
//    copy the link again later.
//  - The link follows the FileNode, so it keeps working after a move or
//    rename, stops while the item is in Trash, and is deleted with it.
//  - Access is re-checked against the creator's permissions on every request.
// ─────────────────────────────────────────────

model ShareLink {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  tokenEnc       String?
  fileNodeId     String
  createdById    String
  passwordHash   String?
  allowDownload  Boolean   @default(true)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  fileNode       FileNode  @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([fileNodeId])
  @@index([createdById])
  @@map("share_links")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// User-facing alerts: interrupted uploads, server-restart failures, etc.
// Stored per-user, survive page refresh, have read/unread state.
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  // UPLOAD_INTERRUPTED, UPLOAD_FAILED, OPERATION_FAILED
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// DEVICES (the Loom desktop and mobile apps)
// A paired app calls the API with "Authorization: Bearer loomd_…". Only
// SHA-256(token) is stored. Removing a device (or its user) cuts it off at
// once; the Owner resetting a user's password removes their devices too.
// ─────────────────────────────────────────────

model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  // "windows", "android", …
  platform   String
  appVersion String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  lastIp     String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions   Session[]
  uploads    UploadSession[]

  @@index([userId])
  @@map("devices")
}

// A device being paired. Two ways in:
//  kind = "approve" — the app starts a request; a signed-in user allows it on
//                     /pair/<id>; the app polls with its secret.
//  kind = "code"    — a signed-in user creates a one-time code (shown as a
//                     QR code on the Devices page); the app redeems it.
// The app may send the SHA-256 of a token it generated itself (tokenHash):
// then no token crosses the wire, and a lost response can simply be retried.
// Rows are short-lived (minutes) and deleted by the hourly housekeeping.
model DevicePairing {
  id         String    @id @default(cuid())
  kind       String
  // SHA-256 of the app's poll secret ("approve") or of the code ("code")
  secretHash String    @unique
  // Short code shown both in the app and on the approval page ("approve")
  checkCode  String?
  deviceName String?
  platform   String?
  appVersion String?
  requestIp  String?
  tokenHash  String?
  // The device created from it, once claimed
  deviceId   String?
  // Who approved it ("approve") or created it ("code")
  userId     String?
  approvedAt DateTime?
  deniedAt   DateTime?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_pairings")
}
