<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Loom" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Android 12+ splash screen: Loom's mark on the window colour. -->
    <style name="Theme.Loom.Starting" parent="Theme.Loom">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/loom_blue</item>
    </style>
</resources>
